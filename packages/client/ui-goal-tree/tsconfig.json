{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The node half (`src/index.ts`) is a Host plugin: it reads the trajectory
    // file and may run the generator through node:child_process. The browser
    // half stays node-free; its purity is gated by the bundle purity plugin in
    // ../tsdown.client.ts, not by the absence of ambient node types.
    "types": ["node"]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../host/webserver"
    },
    {
      "path": "../locale"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../connection/tsconfig.client.json"
    },
    {
      "path": "../ui-sidebar"
    },
    {
      "path": "../ui-slots"
    }
  ]
}
